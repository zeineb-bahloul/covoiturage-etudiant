{
  "expo": {
    "name": "UniRide",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tn.isetnabeul.uniride"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D47A1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "tn.isetnabeul.uniride"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UniRide utilise votre position uniquement pour l'alerte SOS pendant un trajet."
        }
      ]
    ]
  }
}
