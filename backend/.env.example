# Copier ce fichier en .env et remplir les valeurs
PORT=5000
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/uniride
JWT_SECRET=une-longue-phrase-secrete-et-aleatoire
ORS_API_KEY=votre-cle-openrouteservice

# Facultatif
# EMAIL_DOMAINES=isetn.tn          # n'accepter que les e-mails universitaires
# DNS_SERVERS=8.8.8.8,1.1.1.1      # si « querySrv ETIMEOUT » avec Atlas
# MODE_DEMO=true                   # affiche le code « mot de passe oublié » (pas de service d'e-mail)
